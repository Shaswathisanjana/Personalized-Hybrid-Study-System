{
  "name": "cacm-learning",
  "version": "1.0.0",
  "private": true,
  "description": "Integrated learning app with offline Python practice and evidence-based revision tasks",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/core.test.cjs test/roadmap.test.cjs test/student-id.test.cjs test/api.test.cjs",
    "test:core": "node --test test/core.test.cjs",
    "test:roadmap": "node --test test/roadmap.test.cjs",
    "test:student": "node --test test/student-id.test.cjs",
    "test:db": "node --test test/api.test.cjs",
    "test:browser": "node test/browser.cjs",
    "test:home": "node test/home.cjs",
    "test:research": "node --test test/research.test.cjs"
  },
  "dependencies": {
    "@langchain/core": "^0.3.79",
    "@langchain/langgraph": "^0.4.9",
    "axios": "^1.12.2",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "mongoose": "^8.19.1",
    "pyodide": "314.0.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "10.2.1",
    "playwright": "1.58.2"
  }

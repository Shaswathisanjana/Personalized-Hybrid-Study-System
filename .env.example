# ─────────────────────────────────────────────────────────────────
# ONLY THIS ONE KEY IS REQUIRED — AND IT'S FREE
# ─────────────────────────────────────────────────────────────────

# Google Gemini — FREE, no credit card, no billing setup
# Free tier: 1,500 requests/day, 15 requests/minute
# 1. Go to: https://aistudio.google.com/app/apikey
# 2. Sign in with any Google account
# 3. Click "Create API Key" → Copy it → Paste below
GOOGLE_API_KEY=your-gemini-api-key-here

# ─────────────────────────────────────────────────────────────────
# OPTIONAL — improves rate limits, not required to run
# ─────────────────────────────────────────────────────────────────

# Semantic Scholar — optional, gives higher API rate limits
# Free signup: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Your email — used as polite identifier for OpenAlex API (no signup needed)
CROSSREF_MAILTO=youremail@example.com

# ─────────────────────────────────────────────────────────────────
# APP SETTINGS — leave as defaults
# ─────────────────────────────────────────────────────────────────
PRIMARY_LLM=gemini-2.0-flash
FALLBACK_LLM=gemini-1.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma
EXPORT_DIR=./data/exports
PAPER_CACHE_DIR=./data/papers
APP_ENV=development
LOG_LEVEL=INFO
MAX_PAPERS_PER_SEARCH=20
